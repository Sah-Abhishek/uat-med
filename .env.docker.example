# Optional overrides for `docker compose up`. Copy to `.env` (auto-loaded by
# compose) and change anything you like — every value has a sane default, so
# the stack also runs with no .env at all.
#
#   cp .env.docker.example .env

# ── Host ports (the in-container ports are fixed) ──
# The bundled Postgres/Redis are internal-only and intentionally NOT published.
FRONTEND_PORT=8090          # open the app at http://localhost:8090
BACKEND_PORT=2600           # API + Swagger at http://localhost:2600/api/v1/docs

# ── Bundled Postgres credentials (a fresh DB is created on first run) ──
POSTGRES_USER=valerion
POSTGRES_PASSWORD=valerion
POSTGRES_DB=valerion

# ── Secrets / login ──
JWT_SECRET=dev-only-change-me-please-0123456789abcdef0123456789
BOOTSTRAP_ADMIN_EMAIL=admin@valerionhealth.com
BOOTSTRAP_ADMIN_PASSWORD=Admin12345!
