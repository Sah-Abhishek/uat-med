# ───── Runtime ─────
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_GLOBAL_PREFIX=api/v1
APP_PUBLIC_URL=http://localhost:8000

# ───── Database ─────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=valerion
DB_PASSWORD=valerion
DB_NAME=valerion_dev
DB_SSL=false
DB_POOL_SIZE=10

# ───── Redis ─────
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=

# ───── Auth ─────
JWT_SECRET=replace-me-with-a-64-char-random-string
JWT_ACCESS_TTL=60m
JWT_REFRESH_TTL=30d
SESSION_IDLE_TIMEOUT=60m
SESSION_ABSOLUTE_TIMEOUT=24h
MFA_REQUIRED_FOR_ROLES=

# ───── SSO (Azure AD) ─────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/azure/callback
SSO_JIT_PROVISIONING=true
SSO_ALLOWED_EMAIL_DOMAINS=valerionhealth.com,valerionhealth.in

# ───── AWS / S3 ─────
AWS_REGION=us-east-1
S3_BUCKET=valerion-dev-uploads
S3_SSE_KMS_KEY_ID=

# ───── CORS / security ─────
CORS_ORIGINS=http://localhost:3000
ENABLE_SWAGGER_UI=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000

# ───── HIPAA ─────
AUDIT_LOG_RETENTION_YEARS=1
HIPAA_BREACH_NOTIFY_EMAIL=security@valerionhealth.com
PHI_ENCRYPTION_KEY_ID=

# ───── Observability ─────
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=valerion-api-dev
OTEL_TRACE_SAMPLER_RATIO=1.0
